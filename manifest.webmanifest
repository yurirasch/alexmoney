{
  "manifest.webmanifest": {
    "name": "AlexMoney",
    "short_name": "AlexMoney",
    "start_url": "./index.html",
    "display": "standalone",
    "display_override": ["standalone", "fullscreen"],
    "background_color": "#000814",
    "theme_color": "#000814",
    "description": "Sistema de Controle de Cotação — Dólar e Bitcoin em tempo real.",
    "scope": "./",
    "icons": [
      {
        "src": "icons/icon-192.png",
        "sizes": "192x192",
        "type": "image/png"
      },
      {
        "src": "icons/icon-512.png",
        "sizes": "512x512",
        "type": "image/png"
      }
    ]
  },
  "icons": {
    "descricao": "Crie a pasta 'icons' e adicione estes arquivos:",
    "arquivos": [
      "icon-192.png (versão quadrada, fundo gradiente azul-roxo, letras AM no centro)",
      "icon-512.png (igual ao 192, mas maior para alta resolução)"
    ]
  }
}
